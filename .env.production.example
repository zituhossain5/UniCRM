NODE_ENV=production

POSTGRES_DB=unicrm
POSTGRES_USER=unicrm
POSTGRES_PASSWORD=replace_with_database_password

API_HOST=0.0.0.0
API_PORT=4000
APP_URL=https://crm.example.com
CORS_ORIGINS=https://crm.example.com
DATABASE_URL=postgresql://unicrm:replace_with_database_password@postgres:5432/unicrm?schema=public
REDIS_URL=redis://redis:6379

SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=unicrm_session
CSRF_COOKIE_NAME=unicrm_csrf
SESSION_COOKIE_SECURE=true
INVITATION_TTL_SECONDS=172800
PASSWORD_RESET_TTL_SECONDS=3600
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
SEARCH_RATE_LIMIT_WINDOW_SECONDS=60
SEARCH_RATE_LIMIT_MAX=60
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT_MAX=20
INTEGRATION_WEBHOOK_MAX_BYTES=262144
INTEGRATION_WEBHOOK_RATE_LIMIT_MAX=120
INTEGRATION_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
INTEGRATION_WEBHOOK_TIMEOUT_MS=10000
INTEGRATION_SECRET_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
MAILBOX_CONNECTION_TIMEOUT_MS=10000
MAILBOX_MESSAGE_MAX_BYTES=10485760
MAILBOX_SYNC_BATCH_SIZE=100
TRUSTED_PROXY_HOPS=1
REQUEST_ID_HEADER=x-request-id
LOG_FORMAT=json

STORAGE_DRIVER=s3
STORAGE_LOCAL_DIR=.local/uploads
STORAGE_S3_ENDPOINT=https://s3.example.com
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=unicrm-private
STORAGE_S3_ACCESS_KEY_ID=replace_with_s3_access_key
STORAGE_S3_SECRET_ACCESS_KEY=replace_with_s3_secret
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_S3_PREFIX=attachments
FILE_UPLOAD_MAX_BYTES=10485760

EMAIL_DELIVERY_MODE=queue
EMAIL_TRANSPORT=smtp
EMAIL_FROM=UniCRM <noreply@example.com>
SMTP_FROM=UniCRM <noreply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_user
SMTP_PASSWORD=replace_with_smtp_password
DEV_EMAIL_KEY=replace_with_disabled_prod_outbox_key

JOB_QUEUE_PREFIX=unicrm
WORKER_ENABLED=false

NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_CSRF_COOKIE_NAME=unicrm_csrf
