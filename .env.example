NODE_ENV=development

# Docker Compose (local development values only)
POSTGRES_DB=unicrm
POSTGRES_USER=unicrm
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_HTTP_PORT=8025

# API
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGINS=http://localhost:3001
DATABASE_URL=postgresql://unicrm:change_me_local_only@localhost:5432/unicrm?schema=public
REDIS_URL=redis://localhost:6379

# Authentication and security
APP_URL=http://localhost:3001
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=unicrm_session
CSRF_COOKIE_NAME=unicrm_csrf
SESSION_COOKIE_SECURE=false
INVITATION_TTL_SECONDS=172800
PASSWORD_RESET_TTL_SECONDS=3600
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
SEARCH_RATE_LIMIT_WINDOW_SECONDS=60
SEARCH_RATE_LIMIT_MAX=60
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT_MAX=20
INTEGRATION_WEBHOOK_MAX_BYTES=262144
INTEGRATION_WEBHOOK_RATE_LIMIT_MAX=120
INTEGRATION_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
INTEGRATION_WEBHOOK_TIMEOUT_MS=10000
# Optional outside production. Generate with: openssl rand -base64 32
# INTEGRATION_SECRET_ENCRYPTION_KEY=
TRUSTED_PROXY_HOPS=0
REQUEST_ID_HEADER=x-request-id
LOG_FORMAT=pretty

# Storage: local is development/test only. Use STORAGE_DRIVER=s3 in production.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.local/uploads
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_S3_PREFIX=attachments
FILE_UPLOAD_MAX_BYTES=10485760

# Background jobs: production API enqueues email; the worker processes delivery and recurring jobs.
EMAIL_DELIVERY_MODE=direct
JOB_QUEUE_PREFIX=unicrm
WORKER_ENABLED=false

# Development bootstrap (required only when running pnpm bootstrap)
UNICRM_BOOTSTRAP_ORG_NAME=UnicodeIT
UNICRM_BOOTSTRAP_ORG_SLUG=unicodeit
UNICRM_BOOTSTRAP_ADMIN_EMAIL=owner@example.com
UNICRM_BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_password
UNICRM_BOOTSTRAP_ADMIN_FIRST_NAME=UniCRM
UNICRM_BOOTSTRAP_ADMIN_LAST_NAME=Owner

# Email: console keeps messages in a protected development outbox and never logs token URLs.
EMAIL_TRANSPORT=console
EMAIL_FROM=UniCRM <noreply@localhost>
SMTP_FROM=
DEV_EMAIL_KEY=replace_with_a_local_only_outbox_key
SMTP_HOST=
SMTP_PORT=587
# Local Mailpit SMTP is published on this host port by docker-compose.yml.
MAILPIT_SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Web (exposed to the browser; never place secrets in NEXT_PUBLIC_* variables)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_CSRF_COOKIE_NAME=unicrm_csrf
