generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  SESSION_REVOKED
  LOGOUT_ALL
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  USER_INVITED
  INVITATION_RESENT
  INVITATION_CANCELLED
  INVITATION_ACCEPTED
  ACCOUNT_DISABLED
  ROLE_CHANGED
}

enum CompanyStatus {
  PROSPECT
  ACTIVE_CLIENT
  INACTIVE
  ARCHIVED
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadSource {
  REFERRAL
  WEBSITE
  FACEBOOK
  LINKEDIN
  EMAIL
  PHONE
  EXISTING_CLIENT
  PARTNER
  OTHER
}

enum LeadActivityType {
  NOTE
  CALL
  MEETING
  EMAIL
  FOLLOW_UP
  STATUS_CHANGE
  OWNER_CHANGE
  SYSTEM
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum FollowUpType {
  CALL
  MEETING
  EMAIL
  OTHER
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum WorkPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  BLOCKED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  MOBILE_BANKING
  CHEQUE
  OTHER
}

enum NotificationType {
  AUTOMATION
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  FOLLOW_UP_DUE
  PROJECT_DEADLINE_SOON
  QUOTATION_ACCEPTED
  PAYMENT_RECORDED
}

enum ConfigurableEntityType {
  LEAD
  COMPANY
  CONTACT
  PROJECT
}

enum CustomFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  CURRENCY
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
  URL
  EMAIL
  PHONE
}

enum SavedViewEntityType {
  LEAD
  COMPANY
  CONTACT
  PROJECT
  TASK
}

enum SavedViewVisibility {
  PRIVATE
  ORGANIZATION
}

enum DataImportEntityType {
  COMPANY
  CONTACT
  LEAD
}

enum DataExportEntityType {
  COMPANY
  CONTACT
  LEAD
  PROJECT
  TASK
}

enum DataJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum DuplicateEntityType {
  COMPANY
  CONTACT
  LEAD
}

enum MergeEntityType {
  COMPANY
  CONTACT
}

enum IntegrationProvider {
  CUSTOM
  UNICODE_COMMERCE
  META
  SHOPIFY
  WOOCOMMERCE
}

enum IntegrationConnectionStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum IntegrationDirection {
  INBOUND
  OUTBOUND
  BOTH
}

enum IntegrationEventDirection {
  INBOUND
  OUTBOUND
}

enum IntegrationEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum UnicrmIntegrationEntityType {
  LEAD
  COMPANY
  CONTACT
  PROJECT
  TASK
}

enum AutomationEntityType {
  LEAD
  PROJECT
  TASK
  QUOTATION
  PAYMENT
}

enum AutomationTriggerType {
  LEAD_CREATED
  LEAD_STAGE_CHANGED
  LEAD_OWNER_CHANGED
  PROJECT_CREATED
  PROJECT_STATUS_CHANGED
  TASK_CREATED
  TASK_STATUS_CHANGED
  TASK_OVERDUE
  QUOTATION_CREATED
  QUOTATION_STATUS_CHANGED
  PAYMENT_CREATED
}

enum AutomationRunStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  SKIPPED
  FAILED
}

model Organization {
  id                String                  @id @default(uuid()) @db.Uuid
  name              String
  slug              String                  @unique
  status            OrganizationStatus      @default(ACTIVE)
  timezone          String                  @default("UTC") @db.VarChar(64)
  defaultCurrency   String                  @default("BDT") @map("default_currency") @db.VarChar(3)
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  users             User[]
  sessions          AuthSession[]
  roles             Role[]
  invitations       UserInvitation[]
  securityEvents    SecurityEvent[]
  companies         Company[]
  contacts          Contact[]
  pipelines         Pipeline[]
  leads             Lead[]
  leadActivities    LeadActivity[]
  followUps         FollowUp[]
  activityLogs      ActivityLog[]
  pipelineStages    PipelineStage[]
  projects          Project[]
  projectMembers    ProjectMember[]
  tasks             Task[]
  taskComments      TaskComment[]
  attachments       Attachment[]
  quotationCounter  QuotationNumberCounter?
  quotations        Quotation[]
  quotationItems    QuotationItem[]
  payments          Payment[]
  notifications     Notification[]
  customFields      CustomFieldDefinition[]
  customFieldValues CustomFieldValue[]
  tags              Tag[]
  entityTags        EntityTag[]
  savedViews        SavedView[]
  importJobs        DataImportJob[]
  exportJobs        DataExportJob[]
  mergeRecords      DataMergeRecord[]
  integrationConnections IntegrationConnection[]
  integrationEvents      IntegrationEvent[]
  webhookSubscriptions   WebhookSubscription[]
  webhookDeliveries      WebhookDelivery[]
  externalEntityMappings ExternalEntityMapping[]
  automationRules         AutomationRule[]
  automationRuns          AutomationRun[]

  @@map("organizations")
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  firstName           String               @map("first_name")
  lastName            String               @map("last_name")
  email               String
  normalizedEmail     String               @unique @map("normalized_email")
  passwordHash        String?              @map("password_hash")
  status              UserStatus           @default(INVITED)
  emailVerifiedAt     DateTime?            @map("email_verified_at")
  lastLoginAt         DateTime?            @map("last_login_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions            AuthSession[]
  userRoles           UserRole[]
  invitationsSent     UserInvitation[]     @relation("InvitationSender")
  passwordResetTokens PasswordResetToken[]
  securityEvents      SecurityEvent[]
  companiesOwned      Company[]            @relation("CompanyOwner")
  companiesCreated    Company[]            @relation("CompanyCreator")
  contactsCreated     Contact[]            @relation("ContactCreator")
  leadsOwned          Lead[]               @relation("LeadOwner")
  leadsCreated        Lead[]               @relation("LeadCreator")
  leadActivities      LeadActivity[]       @relation("LeadActivityCreator")
  followUpsAssigned   FollowUp[]           @relation("FollowUpAssignee")
  followUpsCreated    FollowUp[]           @relation("FollowUpCreator")
  activityLogs        ActivityLog[]        @relation("ActivityLogActor")
  projectsManaged     Project[]            @relation("ProjectManager")
  projectsCreated     Project[]            @relation("ProjectCreator")
  projectMemberships  ProjectMember[]
  tasksAssigned       Task[]               @relation("TaskAssignee")
  tasksReported       Task[]               @relation("TaskReporter")
  tasksCreated        Task[]               @relation("TaskCreator")
  taskComments        TaskComment[]
  attachmentsUploaded Attachment[]
  quotationsCreated   Quotation[]          @relation("QuotationCreator")
  paymentsRecorded    Payment[]            @relation("PaymentRecorder")
  notifications       Notification[]
  savedViews          SavedView[]
  importJobsCreated   DataImportJob[]      @relation("ImportJobCreator")
  exportJobsCreated   DataExportJob[]      @relation("ExportJobCreator")
  mergeRecordsCreated DataMergeRecord[]    @relation("MergeRecordCreator")
  automationRulesCreated AutomationRule[]   @relation("AutomationRuleCreator")

  @@index([organizationId, status])
  @@map("users")
}

model AuthSession {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  tokenHash      String       @unique @map("token_hash")
  csrfTokenHash  String       @map("csrf_token_hash")
  ipAddress      String?      @map("ip_address")
  userAgent      String?      @map("user_agent")
  createdAt      DateTime     @default(now()) @map("created_at")
  lastUsedAt     DateTime     @default(now()) @map("last_used_at")
  expiresAt      DateTime     @map("expires_at")
  revokedAt      DateTime?    @map("revoked_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([organizationId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  name            String
  description     String?
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  invitations     UserInvitation[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique
  description     String
  createdAt       DateTime         @default(now()) @map("created_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserInvitation {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  invitedById     String       @map("invited_by_id") @db.Uuid
  roleId          String       @map("role_id") @db.Uuid
  firstName       String       @map("first_name")
  lastName        String       @map("last_name")
  email           String
  normalizedEmail String       @map("normalized_email")
  tokenHash       String       @unique @map("token_hash")
  expiresAt       DateTime     @map("expires_at")
  acceptedAt      DateTime?    @map("accepted_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy       User         @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  role            Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([organizationId, normalizedEmail])
  @@index([expiresAt])
  @@map("user_invitations")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model SecurityEvent {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String?           @map("organization_id") @db.Uuid
  userId         String?           @map("user_id") @db.Uuid
  eventType      SecurityEventType @map("event_type")
  ipAddress      String?           @map("ip_address")
  userAgent      String?           @map("user_agent")
  metadata       Json?
  createdAt      DateTime          @default(now()) @map("created_at")
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@map("security_events")
}

model Company {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String
  website        String?
  email          String?
  phone          String?
  industry       String?
  addressLine1   String?       @map("address_line_1")
  addressLine2   String?       @map("address_line_2")
  city           String?
  state          String?
  postalCode     String?       @map("postal_code")
  country        String?
  status         CompanyStatus @default(PROSPECT)
  accountOwnerId String?       @map("account_owner_id") @db.Uuid
  notes          String?
  createdById    String?       @map("created_by_id") @db.Uuid
  archivedAt     DateTime?     @map("archived_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountOwner   User?         @relation("CompanyOwner", fields: [accountOwnerId], references: [id], onDelete: SetNull)
  createdBy      User?         @relation("CompanyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  contacts       Contact[]
  leads          Lead[]
  projects       Project[]
  quotations     Quotation[]
  payments       Payment[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, archivedAt, createdAt])
  @@index([organizationId, name])
  @@index([organizationId, accountOwnerId])
  @@map("companies")
}

model Contact {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  companyId       String?      @map("company_id") @db.Uuid
  firstName       String       @map("first_name")
  lastName        String       @map("last_name")
  jobTitle        String?      @map("job_title")
  email           String?
  normalizedEmail String?      @map("normalized_email")
  phone           String?
  alternatePhone  String?      @map("alternate_phone")
  isPrimary       Boolean      @default(false) @map("is_primary")
  notes           String?
  createdById     String?      @map("created_by_id") @db.Uuid
  archivedAt      DateTime?    @map("archived_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy       User?        @relation("ContactCreator", fields: [createdById], references: [id], onDelete: SetNull)
  leads           Lead[]
  quotations      Quotation[]

  @@unique([companyId], map: "contacts_one_primary_per_company", where: raw("\"is_primary\" = true AND \"archived_at\" IS NULL"))
  @@index([organizationId, companyId, archivedAt])
  @@index([organizationId, archivedAt, createdAt])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, normalizedEmail])
  @@map("contacts")
}

model Pipeline {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  name           String
  isDefault      Boolean         @default(false) @map("is_default")
  archivedAt     DateTime?       @map("archived_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages         PipelineStage[]
  leads          Lead[]

  @@unique([organizationId, name])
  @@unique([organizationId], map: "pipelines_one_active_default", where: raw("\"is_default\" = true AND \"archived_at\" IS NULL"))
  @@index([organizationId, archivedAt, name])
  @@map("pipelines")
}

model PipelineStage {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  pipelineId     String       @map("pipeline_id") @db.Uuid
  name           String
  position       Int
  isWon          Boolean      @default(false) @map("is_won")
  isLost         Boolean      @default(false) @map("is_lost")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline       Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads          Lead[]

  @@unique([pipelineId, name])
  @@unique([pipelineId, position])
  @@index([organizationId, pipelineId, position])
  @@map("pipeline_stages")
}

model Lead {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  companyId       String?        @map("company_id") @db.Uuid
  contactId       String?        @map("contact_id") @db.Uuid
  title           String
  firstName       String?        @map("first_name")
  lastName        String?        @map("last_name")
  email           String?
  normalizedEmail String?        @map("normalized_email")
  phone           String?
  source          LeadSource?
  pipelineId      String         @map("pipeline_id") @db.Uuid
  stageId         String         @map("stage_id") @db.Uuid
  estimatedValue  Decimal?       @map("estimated_value") @db.Decimal(19, 2)
  currency        String         @default("BDT") @db.VarChar(3)
  ownerId         String?        @map("owner_id") @db.Uuid
  priority        LeadPriority   @default(MEDIUM)
  nextFollowUpAt  DateTime?      @map("next_follow_up_at")
  description     String?
  notes           String?
  lostReason      String?        @map("lost_reason")
  createdById     String?        @map("created_by_id") @db.Uuid
  archivedAt      DateTime?      @map("archived_at")
  lastActivityAt  DateTime       @default(now()) @map("last_activity_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company         Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact         Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  pipeline        Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage           PipelineStage  @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner           User?          @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy       User?          @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  activities      LeadActivity[]
  followUps       FollowUp[]
  project         Project?
  quotations      Quotation[]

  @@index([organizationId, stageId, archivedAt])
  @@index([organizationId, ownerId, archivedAt])
  @@index([organizationId, companyId])
  @@index([organizationId, nextFollowUpAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, priority, archivedAt, createdAt])
  @@index([organizationId, source, archivedAt, createdAt])
  @@index([organizationId, normalizedEmail])
  @@map("leads")
}

model LeadActivity {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  leadId         String           @map("lead_id") @db.Uuid
  type           LeadActivityType
  title          String
  description    String?
  occurredAt     DateTime         @default(now()) @map("occurred_at")
  createdById    String?          @map("created_by_id") @db.Uuid
  metadata       Json?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy      User?            @relation("LeadActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, leadId, occurredAt])
  @@index([organizationId, type, occurredAt])
  @@map("lead_activities")
}

model FollowUp {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  leadId         String         @map("lead_id") @db.Uuid
  dueAt          DateTime       @map("due_at")
  status         FollowUpStatus @default(PENDING)
  type           FollowUpType   @default(CALL)
  notes          String?
  assignedToId   String?        @map("assigned_to_id") @db.Uuid
  createdById    String?        @map("created_by_id") @db.Uuid
  completedAt    DateTime?      @map("completed_at")
  cancelledAt    DateTime?      @map("cancelled_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo     User?          @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy      User?          @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueAt])
  @@index([organizationId, assignedToId, status, dueAt])
  @@index([organizationId, leadId, createdAt])
  @@map("follow_ups")
}

model ActivityLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorId        String?      @map("actor_id") @db.Uuid
  entityType     String       @map("entity_type")
  entityId       String       @map("entity_id") @db.Uuid
  action         String
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("ActivityLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId, action, createdAt])
  @@map("activity_logs")
}

model Project {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  companyId        String          @map("company_id") @db.Uuid
  sourceLeadId     String?         @unique @map("source_lead_id") @db.Uuid
  name             String
  description      String?
  projectManagerId String?         @map("project_manager_id") @db.Uuid
  status           ProjectStatus   @default(PLANNED)
  priority         WorkPriority    @default(MEDIUM)
  startDate        DateTime?       @map("start_date") @db.Date
  deadline         DateTime?       @db.Date
  projectValue     Decimal?        @map("project_value") @db.Decimal(19, 2)
  currency         String          @default("BDT") @db.VarChar(3)
  progress         Int             @default(0)
  createdById      String          @map("created_by_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  archivedAt       DateTime?       @map("archived_at")
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sourceLead       Lead?           @relation(fields: [sourceLeadId], references: [id], onDelete: SetNull)
  projectManager   User?           @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
