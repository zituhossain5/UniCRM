  triggerPayload   Json                   @map("trigger_payload")
  actionResults    Json?                  @map("action_results")
  startedAt        DateTime?              @map("started_at")
  completedAt      DateTime?              @map("completed_at")
  errorSummary     String?                @map("error_summary") @db.VarChar(1000)
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automationRule   AutomationRule         @relation(fields: [automationRuleId], references: [id], onDelete: Cascade)

  @@unique([automationRuleId, triggerEventId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, entityType, entityId, createdAt])
  @@map("automation_runs")
}
